---
import Button from "#components/Button.astro";
import Logo from "#components/Logo.astro";
import RootLayout from "#layouts/RootLayout.astro";
import { SUPPORT_EMAIL } from "astro:env/client";
---

<RootLayout title="Page not found">
  <div class="flex flex-col size-full">
    <header class="h-[72px] bg-white">
      <div class="container flex items-center justify-between h-full">
        <Logo />
      </div>
    </header>
    <section class="container flex-1 flex items-center justify-center text-center w-full">
      <div class="space-y-3">
        <span class="block text-[77px]/[1] lg:text-[64px]/[1]">😵</span>
        <h1 class="text-[32px]/[1.25] font-bold px-12">This page does not exist</h1>
        <p class="text-gray-500">We couldn't find the page you're looking for.</p>
        <Button href="/" variant="secondary" size="sm">Start shopping</Button>
      </div>
    </section>
    {SUPPORT_EMAIL && <footer class="container py-8">
      <div class="w-full xl:w-1/2 flex items-center gap-2">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M13.4915 1.66663H6.50817C3.47484 1.66663 1.6665 3.47496 1.6665 6.50829V13.4833C1.6665 16.525 3.47484 18.3333 6.50817 18.3333H13.4832C16.5165 18.3333 18.3248 16.525 18.3248 13.4916V6.50829C18.3332 3.47496 16.5248 1.66663 13.4915 1.66663ZM5.3915 6.43329C5.63317 6.19163 6.03317 6.19163 6.27484 6.43329C6.8665 7.02496 7.83317 7.02496 8.42484 6.43329C8.6665 6.19163 9.0665 6.19163 9.30817 6.43329C9.54984 6.67496 9.54984 7.07496 9.30817 7.31663C8.7665 7.85829 8.05817 8.12496 7.34984 8.12496C6.6415 8.12496 5.93317 7.85829 5.3915 7.31663C5.14984 7.06663 5.14984 6.67496 5.3915 6.43329ZM9.99984 15.65C7.75817 15.65 5.93317 13.825 5.93317 11.5833C5.93317 11 6.40817 10.5166 6.9915 10.5166H12.9915C13.5748 10.5166 14.0498 10.9916 14.0498 11.5833C14.0665 13.825 12.2415 15.65 9.99984 15.65ZM14.6082 7.31663C14.0665 7.85829 13.3582 8.12496 12.6498 8.12496C11.9415 8.12496 11.2332 7.85829 10.6915 7.31663C10.4498 7.07496 10.4498 6.67496 10.6915 6.43329C10.9332 6.19163 11.3332 6.19163 11.5748 6.43329C12.1665 7.02496 13.1332 7.02496 13.7248 6.43329C13.9665 6.19163 14.3665 6.19163 14.6082 6.43329C14.8498 6.67496 14.8498 7.06663 14.6082 7.31663Z"
            fill="#9CA3AF"></path>
        </svg>
        <div class="text-sm text-gray-500">Have questions? <a href={`mailto:${SUPPORT_EMAIL}`} class="font-medium text-gray-900 underline underline-offset-4">Contact us</a></div>
      </div>
    </footer>}
  </div>
</RootLayout>
