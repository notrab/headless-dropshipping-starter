{
  "name": "swagboilerplate",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "imports": {
    "#actions/*": "./src/actions/*.ts",
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#lib/*": "./src/lib/*.ts",
    "#scripts/*": "./src/scripts/*.ts",
    "#stores/*": "./src/stores/*.ts",
    "#utils": "./src/utils.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "check": "astro check",
    "setup": "node scripts/setup.ts",
    "setup:check": "node scripts/setup.ts --check"
  },
  "dependencies": {
    "@alpinejs/persist": "^3.17.5",
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/node": "^11.1.9",
    "@splidejs/splide": "^4.1.4",
    "@stripe/stripe-js": "^10.2.0",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.4",
    "astro-icon": "^1.2.0",
    "clsx": "^2.1.1",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/netlify": "^8.2.10",
    "@astrojs/vercel": "^11.0.17",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.17.0",
    "@types/alpinejs__persist": "^3.17.0",
    "@types/node": "^24.19.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
