# Printful
# Create a private token at https://developers.printful.com/tokens
PRINTFUL_API_TOKEN=your_printful_api_token_here
# Only needed for account-level tokens
# PRINTFUL_STORE_ID=

# Stripe
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Signing secret for /api/stripe-webhook (`stripe listen` prints one locally)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# VAT (see docs/VAT_GUIDE.md)
# true = VAT registered, VAT is added to customer totals
# false = not registered, VAT is absorbed (default)
PASS_THROUGH_VAT=false
# UK_VAT_NUMBER=GB123456789

# Your store's public address, for link previews (Slack, iMessage, X...) and
# canonical URLs. Optional on Vercel and Netlify, which provide it.
# SITE_URL=https://shop.example.com

# Branding (optional)
# STORE_NAME=Swag Store
# SUPPORT_EMAIL=hello@example.com
# THEME=
# LOGO_URL=https://example.com/logo.svg
# LOGO_PATH=/logo.svg
